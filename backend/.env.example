# ProfitGuard AI — Environment Configuration (Placeholder Template)
# Copy this file to .env for local development. NEVER commit real secrets or production keys to version control.

# Application Environment
ENVIRONMENT=development
DEBUG=true
APP_NAME="ProfitGuard AI"
API_V1_STR="/api/v1"

# Database Configuration
# In production, use separate roles:
# MIGRATION_DATABASE_URL: Used by Alembic (owner role with DDL privileges)
# RUNTIME_DATABASE_URL: Used by FastAPI & Celery (application role with DML only & NOBYPASSRLS)
DATABASE_URL=postgresql://pg_user:pg_password@localhost:5432/profitguard_dev
MIGRATION_DATABASE_URL=postgresql://pg_migrator:migrator_password@localhost:5432/profitguard_dev

# JWT Authentication Secrets
# Generate secure 256-bit keys using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application-Level AES-256-GCM Credential Encryption
# Dictionary of versioned 32-byte hex keys: {"v1": "<hex_key>", "v2": "<hex_key>"}
# Generate each key using: python -c "import secrets; print(secrets.token_hex(32))"
# OPERATIONAL RISK NOTE: Keys stored in environment variables are susceptible to container/memory dump.
# For high-compliance enterprise production, migrate to AWS KMS or Google Cloud KMS envelope encryption.
ACTIVE_ENCRYPTION_KEY_VERSION=v1
ENCRYPTION_KEYS={"v1":"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"}

# CORS Allowed Origins (Comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Redis / Celery Configuration (Optional for Milestone 1; placeholder for workers)
REDIS_URL=redis://localhost:6379/0

# Shopify Integration (Phase 4B)
SHOPIFY_API_VERSION=2024-01
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Meta WhatsApp Business Cloud API (Phase 5)
# Operating Modes: MOCK (local/CI) | META_TEST (test numbers) | LIVE (production WABA)
WHATSAPP_OPERATING_MODE=MOCK
WHATSAPP_API_VERSION=v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=profitguard_whatsapp_verify_token_default
WHATSAPP_APP_SECRET=
